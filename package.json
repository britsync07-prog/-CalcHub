{
  "name": "everyday-calculator-hub",
  "version": "1.0.0",
  "private": true,
  "description": "55 free, fast, client-side calculators and converters with static pre-rendering, structured data, and a zero-CLS ad layout.",
  "author": "Musfiqur Rahman Saimon",
  "license": "MIT",
  "homepage": "https://everyday-calculator-hub-cw8.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/britsync07-prog/everyday-calculator-hub.git"
  },
  "bugs": {
    "url": "https://github.com/britsync07-prog/everyday-calculator-hub/issues"
  },
  "keywords": [
    "calculator",
    "online-calculator",
    "unit-converter",
    "percentage-calculator",
    "finance-calculator",
    "react",
    "typescript",
    "vite",
    "static-site-generation",
    "seo"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsx scripts/prerender.ts",
    "build:client": "vite build",
    "build:ssg": "vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
